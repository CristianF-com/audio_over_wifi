# Target: ESP32 clásico (ESP32-WROOM-32D), solo WiFi 2.4 GHz. Requiere ESP-IDF >= 5.1 (el C5 pide 5.5)
CONFIG_IDF_TARGET="esp32"

# OTA por WiFi: dos particiones de aplicación de 1,5 MB (partitions.csv) y flash de 4 MB.
# (con NimBLE + WiFi el binario pasa de 1 MB). Si tu placa tiene menos de 4 MB no se puede usar OTA.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
# Si el firmware nuevo no arranca o no llega a conectarse y sincronizar, el bootloader vuelve al anterior
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# La descarga va por HTTP dentro de la LAN (token de un solo uso); sin esto esp_https_ota exige HTTPS
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

# Tick de 1 ms (la sincronía usa vTaskDelay/timeouts finos)
CONFIG_FREERTOS_HZ=1000

# Cola UDP de lwIP: por defecto solo 6 paquetes (~15 ms). Subir.
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32

# WiFi: buffers para ráfagas de audio UDP
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=48
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16

# I2S ISR segura frente a flash cache
CONFIG_I2S_ISR_IRAM_SAFE=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- Bluetooth LE (NimBLE) para configurar el receptor ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
# Wi-Fi + BLE comparten radio en 2.4 GHz: coexistencia por software (por defecto al activar ambos)
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# 240 MHz (por defecto el ESP32 clásico arranca a 160): más margen para WiFi + audio
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
